# MC3 Multiplayer Relay — Environment Configuration
# Copy this to .env and edit for your deployment

# Server
RELAY_PORT=8080
WSS_PORT=8443
NODE_ENV=production

# Security (CHANGE THESE IN PRODUCTION)
JWT_SECRET=your-super-secret-jwt-key-change-me
CORS_ORIGIN=*  # Set to your domain in production, e.g. https://mc3multiplayer.com

# Database
DATABASE_PATH=/data/mc3_relay.db

# Game limits
MAX_PLAYERS=8
GAME_TIMEOUT=3600
