# MC3 Multiplayer Relay — Environment Configuration
# Copy this to .env and edit for your deployment

# Server
RELAY_PORT=8080
RELAY_HOST=127.0.0.1
NODE_ENV=production

# Security
JWT_SECRET=
# Empty uses a private random key persisted under DATA_DIR.
CORS_ORIGIN=
# Same-origin browser client is served by the relay. For an HTTPS reverse proxy,
# set PUBLIC_ORIGIN to that exact origin (no trailing slash).
PUBLIC_ORIGIN=

# Database
DATA_DIR=./data

# Game limits
MAX_PLAYERS=8
GAME_TIMEOUT=3600
