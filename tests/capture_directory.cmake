add_executable(capture_directory_test "${CMAKE_CURRENT_LIST_DIR}/capture_directory_test.cpp")
target_include_directories(capture_directory_test PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../runtime")
target_compile_features(capture_directory_test PRIVATE cxx_std_20)
if(MSVC)
    target_compile_options(capture_directory_test PRIVATE /UNDEBUG)
else()
    target_compile_options(capture_directory_test PRIVATE -UNDEBUG)
endif()
find_package(Threads REQUIRED)
target_link_libraries(capture_directory_test PRIVATE Threads::Threads)
add_test(NAME capture_directory_isolation COMMAND capture_directory_test)
