add_executable(updates_test "${CMAKE_CURRENT_LIST_DIR}/updates_test.cpp")
target_include_directories(updates_test PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../runtime")
target_compile_features(updates_test PRIVATE cxx_std_20)
if(MSVC)
    target_compile_options(updates_test PRIVATE /UNDEBUG)
else()
    target_compile_options(updates_test PRIVATE -UNDEBUG)
