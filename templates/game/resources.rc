            VALUE "OriginalFilename", "mc3.exe\0"
            VALUE "ProductName", "Midnight Club 3: DUB Edition Remix\0"
            VALUE "ProductVersion", "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
